{
  "expo": {
    "name": "GCQ",
    "slug": "isaac",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#8C1C2E"
    },
    "android": {
      "package": "com.eduardo132.isaac",
      "adaptiveIcon": {
        "backgroundColor": "#8C1C2E"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "SUA_GOOGLE_MAPS_API_KEY_AQUI"
        }
      }
    },
    "ios": {
      "bundleIdentifier": "com.eduardo132.isaac",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O GCQ usa sua localização para rastrear o técnico até o cliente.",
        "NSFaceIDUsageDescription": "Use Face ID para entrar no GCQ com mais rapidez e segurança."
      },
      "config": {
        "googleMapsApiKey": "SUA_GOOGLE_MAPS_API_KEY_AQUI"
      }
    },
    "plugins": [
      "expo-font",
      "expo-local-authentication",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O GCQ usa sua localização para rastrear o técnico até o cliente."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b8b1373d-5939-41b6-b544-110f18e57b3b"
      }
    }
  }
}
